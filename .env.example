# Copy this to `.env` (gitignored) and fill in real values.
# python-dotenv loads it automatically when the orchestra agent starts.

# Anthropic API key — required by the orchestra agent when spawning ephemeral
# Claude sessions via claude-agent-sdk. If unset, the SDK falls back to the
# locally-installed `claude` CLI OAuth credentials.
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Override default team name (default: spike04-test)
# ORCHESTRA_TEAM=your-team-name

# Optional: Your display name in the team (default: guest-ui)
# ORCHESTRA_DISPLAY=your-name

# Optional: Default broker URL (default: ws://localhost:8765/)
# ORCHESTRA_BROKER=wss://your-broker.trycloudflare.com/

# Optional: Default repo path for your agent (default: ~/)
# ORCHESTRA_REPO=/path/to/your/repo

# Optional: Enable debug logging (default: false)
# ORCHESTRA_DEBUG=false
